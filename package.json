{
  "name": "ticket-to-code",
  "displayName": "Ticket to Code",
  "description": "AI-powered coding assistant with Cline-like interface",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:ticketToCode.openPanel"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "ticketToCodeView",
          "name": "Ticket to Code",
          "when": "true"
        }
      ]
    },
    "commands": [
      {
        "command": "ticketToCode.openPanel",
        "title": "Open Chat",
        "category": "Ticket to Code"
      },
      {
        "command": "ticketToCode.sendMessage",
        "title": "Send Message",
        "category": "Ticket to Code"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ticketToCode.openPanel",
          "when": "view == ticketToCodeView",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "ticketToCode.openPanel"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "typescript": "^4.9.4"
  }
}
