{
  "name": "ticket-to-code",
  "displayName": "Ticket to Code",
  "description": "Streamline your workflow from JIRA tickets to code implementation with AI assistance, safe diffs, and Git integration.",
  "publisher": "your-publisher",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "jira",
    "ai",
    "tickets",
    "workflow",
    "git",
    "productivity"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:aiChat",
    "onCommand:ticket-to-code.connectJira",
    "onCommand:ticket-to-code.startSession",
    "onCommand:ticket-to-code.openWebsite"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ticket-to-code",
          "title": "Ticket to Code",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "ticket-to-code": [
        {
          "id": "jiraConnection",
          "name": "Connection",
          "type": "webview"
        },
        {
          "id": "aiChat",
          "name": "AI Assistant",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "ticket-to-code.connectJira",
        "title": "Ticket to Code: Connect to JIRA"
      },
      {
        "command": "ticket-to-code.startSession",
        "title": "Ticket to Code: Start AI Session"
      },
      {
        "command": "ticket-to-code.showTickets",
        "title": "Ticket to Code: Show Tickets"
      },
      {
        "command": "ticket-to-code.showTicket",
        "title": "Ticket to Code: Show Ticket"
      },
      {
        "command": "ticket-to-code.loadTickets",
        "title": "Ticket to Code: Load Tickets"
      }
    ],
    "keybindings": [
      {
        "command": "ticket-to-code.showTickets",
        "key": "ctrl+shift+t"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Ticket to Code",
      "properties": {
        "ticket-to-code.jira.url": {
          "type": "string",
          "default": "",
          "description": "JIRA base URL (e.g., https://company.atlassian.net)"
        },
        "ticket-to-code.ai.model": {
          "type": "string",
          "default": "gpt-4",
          "description": "AI model identifier"
        },
        "ticket-to-code.autoIndex": {
          "type": "boolean",
          "default": true,
          "description": "Automatically index code on workspace open"
        },
        "ticket-to-code.autoGenerateTests": {
          "type": "boolean",
          "default": true,
          "description": "Generate tests for changes"
        },
        "ticket-to-code.gitIntegration.autoCreateBranch": {
          "type": "boolean",
          "default": true
        },
        "ticket-to-code.gitIntegration.branchNamingPattern": {
          "type": "string",
          "default": "feature/{ticket-id}-{description}"
        }
      }
    }
  },
  "scripts": {
    "build": "webpack --mode production",
    "watch": "webpack --watch --mode development",
    "gen:doc": "node scripts/generateDoc.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.90.0",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  }
}
